{
  "name": "@pixelo-ai/cli",
  "version": "0.1.0",
  "pixelo": {
    "clientId": "pixelo-cli"
  },
  "description": "Pixelo CLI — generate images and videos from your terminal, billed to your Pixelo account.",
  "keywords": [
    "pixelo",
    "image-generation",
    "video-generation",
    "cli"
  ],
  "homepage": "https://pixelo.ai/mcp",
  "bugs": {
    "url": "https://github.com/pixelo-ai/pixelo-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelo-ai/pixelo-cli.git"
  },
  "author": "Pixelo",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "pixelo": "./dist/pixelo.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --outfile dist/pixelo.js --target node --banner '#!/usr/bin/env node' && chmod +x dist/pixelo.js",
    "build:binary": "bun build src/index.ts --compile --outfile dist/pixelo",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:metadata": "node scripts/check-package-metadata.mjs",
    "prepack": "bun run typecheck && bun test && bun run check:metadata && bun run build",
    "release:check": "bun run prepack && npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.5",
    "typescript": "^6.0.3"
  }
}
